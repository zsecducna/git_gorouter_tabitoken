# env.example — documented template for the repo-root .env (real .env is
# gitignored; NEVER copy real values into this file).
# Copy to ../.env and fill in. OTP source selection is env-priority:
#   1. RESEND_API_KEY set  -> Resend inbound API
#   2. else MAIL_PASS      -> IMAP catch-all (mail.duke-kr.win)
#   3. neither             -> pipelines abort at boot with a clear error

# --- Resend (option 1) ---
RESEND_API_KEY=re_xxx

# --- IMAP catch-all (option 2) ---
MAIL_PASS=xxx
# Optional overrides (defaults shown):
# MAIL_HOST=mail.duke-kr.win
# MAIL_USER=me@duke-kr.win          # catch-all reader user
# MAIL_CATCHALL_USER=me@duke-kr.win # explicit catch-all override (wins over MAIL_USER for OTP reading)
# MAIL_DOMAIN=duke-kr.win           # re-target the catch-all domain

# --- Site signup URLs (optional, affiliate-tagged) ---
# GOROUTER_SIGNUP_URL=https://gorouter.app/sign-up?aff=Jju8
# TABITOKEN_SIGNUP_URL=https://tabitoken.com/sign-up?aff=fPbO

# --- Lane control (set per invocation, not persisted) ---
# FAST=1        register + site logins only, keys later
# FROM=user0500listingstudio TO=user0600listingstudio   # claim range for one lane
